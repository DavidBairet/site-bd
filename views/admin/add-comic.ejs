<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Ajouter une BD</title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" type="image/png" href="/images/favicon1.png">
</head>

<body>

<main class="admin-page">

    <div class="admin-header">

        <div>
            <p class="eyebrow">Administration</p>
            <h1>Ajouter une BD</h1>
        </div>

        <a href="/admin" class="btn">
            ← Retour au dashboard
        </a>

    </div>


    <form
        action="/admin/bd/ajouter"
        method="POST"
        enctype="multipart/form-data"
    >

        <label for="title">
            Titre
        </label>

        <input
            type="text"
            id="title"
            name="title"
            required
        >


        <label for="description">
            Description
        </label>

        <textarea
            id="description"
            name="description"
            rows="6"
            required
        ></textarea>


        <label for="coverImage">
            Couverture
        </label>

        <input
            type="file"
            id="coverImage"
            name="coverImage"
            accept="image/*"
            required
        >


        <label for="pdfFile">
            BD au format PDF
        </label>

        <input
            type="file"
            id="pdfFile"
            name="pdfFile"
            accept="application/pdf"
            required
        >


       <label class="checkbox-field">
    <input
        type="checkbox"
        name="downloadable"
    >
    <span>Autoriser le téléchargement</span>
</label>

<label class="checkbox-field">
    <input
        type="checkbox"
        name="published"
        checked
    >
    <span>Publier la BD</span>
</label>

        <button type="submit">
            Ajouter la BD
        </button>

    </form>

</main>

</body>

</html>