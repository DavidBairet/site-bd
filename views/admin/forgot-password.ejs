<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Mot de passe oublié — Loukas</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <link
        rel="icon"
        type="image/png"
        href="/images/favicon1.png"
    >
</head>

<body>

    <main class="admin-login">

        <div class="login-container">

            <p class="eyebrow">
                Administration
            </p>

            <h1>Mot de passe oublié ?</h1>

            <p>
                Entre l'adresse e-mail associée à ton compte.
                Un lien permettant de choisir un nouveau mot
                de passe te sera envoyé.
            </p>


            <% if (success) { %>

                <div class="success-message">
                    <%= success %>
                </div>

            <% } %>


            <% if (error) { %>

                <div class="login-error">
                    <%= error %>
                </div>

            <% } %>


            <form
                action="/admin/forgot-password"
                method="POST"
                class="login-form"
            >

                <div class="form-group">

                    <label for="email">
                        Adresse e-mail
                    </label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        autocomplete="email"
                        required
                    >

                </div>


                <button type="submit">
                    Envoyer le lien
                </button>

            </form>


            <div class="login-links">

                <a href="/admin/login">
                    ← Retour à la connexion
                </a>

            </div>

        </div>

    </main>

</body>

</html>