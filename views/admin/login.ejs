<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Connexion administration — Loukas</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <main class="admin-login">

        <div class="login-container">

            <a href="/" class="legal-back">
                ← Retour au site
            </a>

            <h1>Administration</h1>

            <p>
                Connectez-vous pour gérer le portfolio.
            </p>

            <% if (error) { %>

                <div class="login-error">
                    <%= error %>
                </div>

            <% } %>

            <form
                action="/admin/login"
                method="POST"
                class="login-form"
            >

                <div class="form-group">

                    <label for="login">
                        Identifiant ou adresse e-mail
                    </label>

                    <input
                        type="text"
                        id="login"
                        name="login"
                        required
                        autocomplete="username"
                    >

                </div>


                <div class="form-group">

                    <label for="password">
                        Mot de passe
                    </label>

                    <input
                        type="password"
                        id="password"
                        name="password"
                        required
                        autocomplete="current-password"
                    >

                </div>


                <button type="submit">
                    Se connecter
                </button>

            </form>


            <div class="login-links">

               <a href="/admin/forgot-password">
    Mot de passe oublié ?
</a>

            </div>

        </div>

    </main>

</body>

</html>