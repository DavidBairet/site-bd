<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Administration - Mes BD</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<main class="admin-page">

    <div class="admin-header">
        <div>
            <p class="eyebrow">Administration</p>
            <h1>Mes BD</h1>
        </div>

        <a href="/admin/bd/ajouter" class="btn">
            + Ajouter une BD
        </a>
    </div>

    <% if (comics.length === 0) { %>

        <div class="admin-empty">
            <h2>Aucune BD pour le moment</h2>
            <p>
                Ajoute ta première bande dessinée pour commencer.
            </p>

            <a href="/admin/bd/ajouter" class="btn">
                Ajouter ma première BD
            </a>
        </div>

    <% } else { %>

        <div class="admin-list">

            <% comics.forEach(comic => { %>

                <article class="admin-comic">

                    <img
                        src="<%= comic.coverImage %>"
                        alt="Couverture de <%= comic.title %>"
                    >

                    <div>
                        <h2><%= comic.title %></h2>

                        <p>
                            Statut :
                            <strong>
                                <%= comic.published ? 'Publié' : 'Brouillon' %>
                            </strong>
                        </p>

                        <p>
                            Téléchargement :
                            <strong>
                                <%= comic.downloadable ? 'Autorisé' : 'Désactivé' %>
                            </strong>
                        </p>
                    </div>

                </article>

            <% }) %>

        </div>

    <% } %>

</main>

</body>
</html>