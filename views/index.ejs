<!DOCTYPE html>

<html lang="fr">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Portfolio BD - Loukas</title>

    <link rel="stylesheet" href="/css/style.css">

    <link rel="icon" type="image/png" href="/images/favicon1.png">

</head>

<body>

<header class="header">

    <div class="container nav">

        <a href="/" class="logo">
            Loukas
        </a>

        <nav>

            <a href="#bd">BD</a>

            <a href="#about">À propos</a>

            <a href="#contact">Contact</a>

        </nav>

    </div>

</header>


<main>

    <!-- HERO -->

    <section class="hero">

        <div class="hero-overlay">

            <p class="eyebrow">
                Auteur • Illustrateur • Bande dessinée
            </p>

            <h1>
                Bienvenue dans<br>
                mon univers.
            </h1>

            <p class="hero-text">

                Découvrez mes bandes dessinées, mes illustrations
                et les personnages qui peuplent mon univers.

            </p>

            <a href="#bd" class="btn">
                Découvrir mes créations
            </a>

        </div>

    </section>


    <!-- BANDES DESSINÉES -->

    <section id="bd" class="section container">

        <div class="section-heading">

            <p class="eyebrow">
                Publications
            </p>

            <h2>
                Mes bandes dessinées
            </h2>

        </div>


        <div class="comics-grid">

            <% if (comics && comics.length > 0) { %>

                <% comics.forEach((comic, index) => { %>

                    <article class="comic-card">

                        <div class="comic-cover">

                            <img
                                src="<%= comic.coverImage %>"
                                alt="Couverture de <%= comic.title %>"
                                loading="lazy"
                            >

                        </div>


                        <div class="comic-content">

                            <p class="comic-number">

                                BD N°<%= String(index + 1).padStart(2, '0') %>

                            </p>

                            <h3>
                                <%= comic.title %>
                            </h3>

                            <p>
                                <%= comic.description %>
                            </p>


                            <div class="comic-actions">

                                <a
                                    href="<%= comic.pdfFile %>"
                                    target="_blank"
                                    rel="noopener"
                                    class="btn"
                                >
                                    Lire
                                </a>


                                <% if (comic.downloadable) { %>

                                    <a
                                        href="<%= comic.pdfFile %>"
                                        download
                                        class="btn btn-outline"
                                    >
                                        Télécharger
                                    </a>

                                <% } %>

                            </div>

                        </div>

                    </article>

                <% }) %>


            <% } else { %>

                <p>
                    Aucune bande dessinée disponible pour le moment.
                </p>

            <% } %>

        </div>

    </section>


    <!-- À PROPOS -->

    <section id="about" class="about">

        <div class="container about-content">

            <div>

                <p class="eyebrow">
                    L'artiste
                </p>

                <h2>
                    À propos
                </h2>

            </div>


            <div class="about-profile">

                <% if (profile && profile.profileImage) { %>

                    <img
                        src="<%= profile.profileImage %>"
                        alt="Photo de Loukas"
                        class="about-image"
                    >

                <% } %>


                <% if (profile && profile.aboutText) { %>

                    <p class="about-text">
                        <%= profile.aboutText %>
                    </p>

                <% } else { %>

                    <p class="about-text">
                        Présentation de l'artiste à venir.
                    </p>

                <% } %>

            </div>

        </div>

    </section>


    <!-- CONTACT -->

    <section id="contact" class="section container contact">

        <p class="eyebrow">
            Contact
        </p>

        <h2>
            Une question ou envie de découvrir mon travail ?
        </h2>


        <% if (profile && profile.contactEmail) { %>

            <a
                href="mailto:<%= profile.contactEmail %>"
                class="btn"
            >
                Me contacter
            </a>

        <% } else { %>

            <a
                href="mailto:danslaforetfanzine@gmail.com"
                class="btn"
            >
                Me contacter
            </a>

        <% } %>

    </section>

</main>


<%- include('partials/footer') %>

</body>

</html>