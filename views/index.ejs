<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Jane Doe - Portfolio artistique</title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" type="image/png" href="/images/favicon1.png">
</head>

<body>

<header class="header">

    <div class="container nav">

        <a href="/" class="logo">
            Jane Doe
        </a>

        <nav>
            <a href="#bd">BD</a>
            <a href="#portfolio">Créations</a>
            <a href="#about">À propos</a>
            <a href="#contact">Contact</a>
        </nav>

    </div>

</header>


<main>

    <!-- =========================
         HERO
    ========================== -->

    <section class="hero">

        <div class="hero-overlay">

            <p class="eyebrow">
                Portfolio artistique
            </p>

            <h1>
                Bienvenue dans<br>
                mon univers.
            </h1>

            <p class="hero-text">
                Découvrez mes bandes dessinées, mes illustrations,
                mes photographies et mes créations artistiques.
            </p>

            <a href="#portfolio" class="btn">
                Découvrir mes créations
            </a>

        </div>

    </section>


    <!-- =========================
         BANDES DESSINÉES
    ========================== -->

    <section id="bd" class="section container">

        <div class="section-heading">

            <p class="eyebrow">
                Publications
            </p>

            <h2>
                Mes bandes dessinées
            </h2>

        </div>


        <div class="comics-grid">

            <% if (comics && comics.length > 0) { %>

                <% comics.forEach((comic, index) => { %>

                    <article class="comic-card">

                        <div class="comic-cover">

                            <img
                                src="<%= comic.coverImage %>"
                                alt="Couverture de <%= comic.title %>"
                                loading="lazy"
                            >

                        </div>


                        <div class="comic-content">

                            <p class="comic-number">
                                BD N°<%= String(index + 1).padStart(2, '0') %>
                            </p>

                            <h3>
                                <%= comic.title %>
                            </h3>

                            <p>
                                <%= comic.description %>
                            </p>


                            <div class="comic-actions">

                                <a
                                    href="<%= comic.pdfFile %>"
                                    target="_blank"
                                    rel="noopener"
                                    class="btn"
                                >
                                    Lire
                                </a>


                                <% if (comic.downloadable) { %>

                                    <a
                                        href="<%= comic.pdfFile %>"
                                        download
                                        class="btn btn-outline"
                                    >
                                        Télécharger
                                    </a>

                                <% } %>

                            </div>

                        </div>

                    </article>

                <% }) %>


            <% } else { %>

                <p>
                    Aucune bande dessinée disponible pour le moment.
                </p>

            <% } %>

        </div>

    </section>


    <!-- =========================
         PORTFOLIO
    ========================== -->

    <section id="portfolio" class="section container">

        <div class="section-heading">

            <p class="eyebrow">
                Portfolio
            </p>

            <h2>
                Mes créations
            </h2>

        </div>


        <div class="comics-grid">

            <% if (artworks && artworks.length > 0) { %>

                <% artworks.forEach(artwork => { %>

                    <article class="comic-card">

                        <!-- IMAGE CLIQUABLE -->

                        <div
                            class="comic-cover artwork-open"
                            data-image="<%= artwork.image %>"
                            data-title="<%= artwork.title %>"
                            role="button"
                            tabindex="0"
                            aria-label="Afficher <%= artwork.title %> en grand"
                        >

                            <img
                                src="<%= artwork.image %>"
                                alt="<%= artwork.title %>"
                                loading="lazy"
                            >

                            <span class="artwork-view">
                                Voir l'œuvre
                            </span>

                        </div>


                        <div class="comic-content">

                            <p class="comic-number">

                                <%= artwork.type === 'photographie'
                                    ? 'Photographie'
                                    : artwork.type === 'sculpture'
                                        ? 'Sculpture'
                                        : artwork.type === 'peinture'
                                            ? 'Peinture'
                                            : 'Illustration'
                                %>

                            </p>

                            <h3>
                                <%= artwork.title %>
                            </h3>

                            <p>
                                <%= artwork.description %>
                            </p>

                        </div>

                    </article>

                <% }) %>


            <% } else { %>

                <p>
                    Mes prochaines créations seront bientôt disponibles.
                </p>

            <% } %>

        </div>

    </section>


    <!-- =========================
         À PROPOS
    ========================== -->

    <section id="about" class="about">

        <div class="container about-content">

            <div>

                <p class="eyebrow">
                    L'artiste
                </p>

                <h2>
                    À propos
                </h2>

            </div>


            <div class="about-profile">

                <% if (profile && profile.profileImage) { %>

                    <img
                        src="<%= profile.profileImage %>"
                        alt="Portrait de Jane Doe"
                        class="about-image"
                    >

                <% } %>


                <% if (profile && profile.aboutText) { %>

                    <p class="about-text">
                        <%= profile.aboutText %>
                    </p>

                <% } else { %>

                    <p class="about-text">
                        Artiste passionnée par l'image et la création,
                        j'explore différents univers à travers
                        l'illustration, la bande dessinée et la photographie.
                    </p>

                <% } %>

            </div>

        </div>

    </section>


    <!-- =========================
         CONTACT
    ========================== -->

    <section id="contact" class="section container contact">

        <p class="eyebrow">
            Contact
        </p>

        <h2>
            Une question ou envie de découvrir mon travail ?
        </h2>


        <% if (profile && profile.contactEmail) { %>

            <a
                href="mailto:<%= profile.contactEmail %>"
                class="btn"
            >
                Me contacter
            </a>

        <% } else { %>

            <p>
                Les coordonnées de contact seront bientôt disponibles.
            </p>

        <% } %>

    </section>

</main>


<!-- =========================
     FOOTER
========================== -->

<%- include('partials/footer') %>


<!-- =========================
     LIGHTBOX
========================== -->

<div
    class="lightbox"
    id="artworkLightbox"
    aria-hidden="true"
>

    <button
        class="lightbox-close"
        id="lightboxClose"
        type="button"
        aria-label="Fermer l'image"
    >
        ×
    </button>


    <div class="lightbox-content">

        <img
            src=""
            alt=""
            id="lightboxImage"
        >

        <p id="lightboxTitle"></p>

    </div>

</div>


<!-- =========================
     SCRIPT LIGHTBOX
========================== -->

<script>

    const artworkButtons =
        document.querySelectorAll('.artwork-open');

    const lightbox =
        document.getElementById('artworkLightbox');

    const lightboxImage =
        document.getElementById('lightboxImage');

    const lightboxTitle =
        document.getElementById('lightboxTitle');

    const lightboxClose =
        document.getElementById('lightboxClose');


    function openLightbox(artwork) {

        lightboxImage.src =
            artwork.dataset.image;

        lightboxImage.alt =
            artwork.dataset.title;

        lightboxTitle.textContent =
            artwork.dataset.title;


        lightbox.classList.add(
            'active'
        );

        lightbox.setAttribute(
            'aria-hidden',
            'false'
        );

        document.body.classList.add(
            'lightbox-open'
        );

    }


    function closeLightbox() {

        lightbox.classList.remove(
            'active'
        );

        lightbox.setAttribute(
            'aria-hidden',
            'true'
        );

        lightboxImage.src = '';

        document.body.classList.remove(
            'lightbox-open'
        );

    }


    artworkButtons.forEach(artwork => {

        artwork.addEventListener(
            'click',
            () => {

                openLightbox(
                    artwork
                );

            }
        );


        artwork.addEventListener(
            'keydown',
            event => {

                if (
                    event.key === 'Enter' ||
                    event.key === ' '
                ) {

                    event.preventDefault();

                    openLightbox(
                        artwork
                    );

                }

            }
        );

    });


    lightboxClose.addEventListener(
        'click',
        closeLightbox
    );


    lightbox.addEventListener(
        'click',
        event => {

            if (
                event.target === lightbox
            ) {

                closeLightbox();

            }

        }
    );


    document.addEventListener(
        'keydown',
        event => {

            if (
                event.key === 'Escape' &&
                lightbox.classList.contains('active')
            ) {

                closeLightbox();

            }

        }
    );

</script>

</body>

</html>